    {
        "id": "dead829c8e7a5e11",
        "type": "function",
        "z": "fd5afb7e9d703e63",
        "name": "Cek Threshold Suhu",
        "func": "\nconst threshold = flow.get(\"threshold\") || 30;\nconst suhu = Number(msg.payload.suhu);\n\nif (Number.isFinite(suhu) && suhu > threshold) {\n    msg.payload = {\n        status: \"warning\",\n        message: \"PERINGATAN! Suhu melewati batas!\",\n        suhu: suhu,\n        threshold: threshold\n    };\n\n    return msg;\n}\n\nreturn null;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
