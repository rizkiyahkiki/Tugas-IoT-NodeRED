        "type": "function",
        "z": "fd5afb7e9d703e63",
        "name": "Simpan Riwayat ke SQLite",
        "func": "\nvar data = msg.payload;\n\nvar suhu = Number(data.suhu);\nvar kelembaban = Number(data.kelembaban);\nvar received = data.received || new Date().toISOString();\n\nmsg.topic = \"INSERT INTO sensor_history (suhu, kelembaban, received) VALUES (?, ?, ?)\";\n\nmsg.payload = [suhu, kelembaban, received];\n\nreturn msg;\n",
