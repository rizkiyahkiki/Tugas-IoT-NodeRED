    {
        "id": "proc_kontrol",
        "type": "function",
        "z": "fd5afb7e9d703e63",
        "name": "Validasi & Publish",
        "func": "var body = msg.payload;\nif (!body.device || !body.action) {\n msg.statusCode = 400;\n msg.payload = {status: 'error', message: 'device dan action wajib diisi'};\n msg.headers = {'Access-Control-Allow-Origin': '*'};\n return msg;\n}\n\nvar mqttMsg = {payload: body, topic: 'iot/kontrol'};\nnode.send([null, mqttMsg]);\n\nmsg.statusCode = 200;\nmsg.payload = {\n status: 'success', \n message: 'Perintah terkirim', \n sent: body\n};\nmsg.headers = {'Access-Control-Allow-Origin': '*'};\nreturn [msg, null];",
        "outputs": 2,
        "x": 380,
        "y": 320,
        "wires": [
            [
                "http_resp_kontrol"
            ],
            [
                "mqtt_publish_kontrol"
