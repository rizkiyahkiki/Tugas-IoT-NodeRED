    {
        "id": "9b83d51056e75e09",
        "type": "function",
        "z": "fd5afb7e9d703e63",
        "name": "Simpan Threshold",
        "func": "\nconst threshold = Number(msg.payload.threshold);\n\nif (\n    msg.payload.threshold === undefined ||\n    msg.payload.threshold === \"\" ||\n    !Number.isFinite(threshold) ||\n    threshold <= 0\n) {\n    msg.statusCode = 400;\n    msg.payload = {\n        status: \"error\",\n        message: \"Batas suhu harus berupa angka lebih dari 0\"\n    };\n    return msg;\n}\n\nflow.set(\"threshold\", threshold);\n\nmsg.payload = {\n    status: \"success\",\n    message: \"Batas suhu berhasil disimpan\",\n    threshold: threshold\n};\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 390,
